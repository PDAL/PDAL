#
# HDF5
#

set (HDF5_FIND_COMPONENTS "CXX")
find_package(HDF5 COMPONENTS CXX REQUIRED )
if(HDF5_FOUND)
    if(HDF5_INCLUDE_DIRS AND NOT HDF5_INCLUDE_DIR)
        set(HDF5_INCLUDE_DIR ${HDF5_INCLUDE_DIRS})
    endif()
    set(PDAL_HDF5_COMPILE_DEFINITIONS HAVE_HDF5=1)
    if (WIN32)
        list(APPEND PDAL_HDF5_COMPILE_DEFINITIONS H5_BUILT_AS_DYNAMIC_LIB=1)
    endif()
    set(PDAL_HAVE_HDF5 1)
endif()
